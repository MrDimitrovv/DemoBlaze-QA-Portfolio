    {
      "name": "Get cookie",
      "item": [
        {
          "name": "Get cookie token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Check should return user item\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    pm.expect(response.Item).to.exist;\r",
                  "    pm.expect(response.Item.token).to.exist;\r",
                  "    pm.expect(response.Item.username).to.eql(pm.environment.get(\"username\"));\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"cookie\", response.Item.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"token\": {{token}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/check",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "check"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Add to cart",
      "item": [
        {
          "name": "Add product to cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Product added to cart\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const cartId = pm.variables.replaceIn(\"{{$guid}}\");\r",
                  "\r",
                  "pm.environment.set(\"cartId\", cartId);\r",
                  "pm.environment.set(\"productId\", 1);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": \"{{cartId}}\",\r\n  \"cookie\": \"{{cookie}}\",\r\n  \"prod_id\": \"{{productId}}\",\r\n  \"flag\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/addtocart",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "addtocart"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "View cart",
      "item": [
        {
          "name": "View cart & assure item is correctly stored",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"View cart request should succeed\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Cart should contain at least one item\", function () {\r",
                  "    pm.expect(response.Items).to.be.an(\"array\");\r",
                  "    pm.expect(response.Items.length).to.be.above(0);\r",
                  "});\r",
                  "pm.test(\"Cart should contain product with ID 1\", function () {\r",
                  "    const hasProductOne = response.Items.some(item => String(item.prod_id) === \"1\");\r",
                  "\r",
                  "    pm.expect(hasProductOne).to.be.true;\r",
                  "});\r",
                  "if (response.Items && response.Items.length > 0) {\r",
                  "    pm.environment.set(\"cartItemId\", response.Items[0].id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"cookie\": \"{{cookie}}\",\r\n    \"flag\": true\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/viewcart",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "viewcart"
              ]
            }
          },
          "response": []
        }
      ]
    },
